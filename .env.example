# Informatica IICS credentials (used to obtain MDM session)
IICS_USER=shguha_adv_suborg
IICS_PASS=Apple@2026

# MDM environment base URL — swap pod/region for your org
# e.g. https://usw1-mdm.dmp-us.informaticacloud.com
MDM_BASE_URL=https://usw1-mdm.dmp-us.informaticacloud.com

# IICS login host (default is correct for most orgs)
IICS_LOGIN_HOST=https://dmp-us.informaticacloud.com

# Entity type mapping — logical name to MDM entityType string (JSON)
# Defaults are built into the server; only set this to override for a specific environment
# ENTITY_TYPES={"person":"c360_person_1780596889717","guest":"c360_person_1780596889717","organization":"c360.organization","org":"c360.organization"}

# OAuth client credentials — you define these, then give them to Databricks
OAUTH_CLIENT_ID=JAVANAVI
OAUTH_CLIENT_SECRET=STRONGJAVANAVI

# Ports (defaults work for local and Cloud Run)
PORT=8000        # MCP endpoint
OAUTH_PORT=8080  # OAuth token endpoint
